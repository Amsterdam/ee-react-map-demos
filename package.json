{
  "name": "ee-react-template",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint:scripts": "eslint . --ext .ts,.tsx,.json",
    "lint:styles": "stylelint ./**/*.{css,scss}",
    "format:scripts": "prettier . --write",
    "format:styles": "stylelint ./**/*.{css,scss} --fix",
    "format": "npm run format:scripts && npm run format:styles",
    "prepare": "husky",
    "uninstall-husky": "npm uninstall husky --no-save && git config --unset core.hooksPath && npx rimraf .husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.5.1",
    "@storybook/addon-actions": "^8.2.1",
    "@storybook/addon-essentials": "^8.5.1",
    "@storybook/addon-interactions": "^8.5.1",
    "@storybook/addon-links": "^8.5.1",
    "@storybook/addon-themes": "^8.5.1",
    "@storybook/blocks": "^8.2.1",
    "@storybook/react": "^8.2.1",
    "@storybook/react-vite": "^10.4.6",
    "@storybook/test": "^8.2.1",
    "@storybook/theming": "^8.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^21.1.7",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^20.17.16",
    "@types/proj4": "^2.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sinon": "^17.0.3",
    "@types/supercluster": "^7.1.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-storybook": "^0.8.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.15",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.10",
    "sinon": "^18.0.1",
    "storybook": "^8.6.17",
    "stylelint": "^16.14.0",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-sass-guidelines": "^11.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^8.1.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@amsterdam/design-system-assets": "^1.0.0",
    "@amsterdam/design-system-css": "^1.0.0",
    "@amsterdam/design-system-react": "^1.1.0",
    "@amsterdam/design-system-react-icons": "^1.0.0",
    "@amsterdam/design-system-tokens": "^1.0.1",
    "geojson": "^0.5.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "supercluster": "^8.0.1"
  }
